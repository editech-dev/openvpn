[Unit]
Description=Aviso de arranque del servidor OpenVPN
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=@USER@
WorkingDirectory=@DIR@
# Espera a que haya red y DNS para poder contactar con Telegram.
ExecStartPre=/bin/sleep 30
ExecStart=@DIR@/scripts/watchdog.sh --boot

[Install]
WantedBy=multi-user.target
