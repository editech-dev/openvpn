[Unit]
Description=Actualización automática de OpenVPN/DuckDNS (con vuelta atrás)
Documentation=file://@DIR@/docs/AUTO-UPDATE.md
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service
OnFailure=openvpn-notify-failure@%n.service

[Service]
Type=oneshot
User=@USER@
WorkingDirectory=@DIR@
ExecStart=@DIR@/scripts/auto-update.sh
# 3 = fallo ya gestionado (vuelta atrás + aviso enviado).
SuccessExitStatus=3
TimeoutStartSec=20min
Nice=10
IOSchedulingClass=idle
