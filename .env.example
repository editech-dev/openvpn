# ============================================================================
#  Configuración de openvpn + duckdns
#  Copia este archivo:  cp .env.example .env   y edita los valores.
#  .env NUNCA se sube a git (está en .gitignore).
# ============================================================================

# Perfiles de Compose a activar. Quita "duckdns" si usas IP fija u otro DDNS.
COMPOSE_PROFILES=duckdns

# Zona horaria (logs y fechas).
TZ=UTC

# ---------------------------------------------------------------- DuckDNS ---
# Subdominio(s) separados por coma, SIN ".duckdns.org"  (ej. mivpn,mivpn2)
DUCKDNS_SUBDOMAINS=mivpn
# Token de https://www.duckdns.org (secreto). Alternativa más segura: Docker
# secrets, ver compose.override.example.yaml.
DUCKDNS_TOKEN=
# ipv4 | ipv6 | both
DUCKDNS_UPDATE_IP=ipv4
# UID/GID con los que corre el contenedor de DuckDNS.
PUID=1000
PGID=1000

# ---------------------------------------------------------------- OpenVPN ---
# Versión de la imagen ghcr.io/editech-dev/openvpn (ej. 1.0.0). "latest" o
# sin publicar => se construye localmente desde ./openvpn.
OVPN_IMAGE_TAG=latest

# Lista de usuarios PERMITIDOS, separados por coma. Es la fuente de verdad:
#  - usuario nuevo   => se le emite un certificado al aplicar (make apply)
#  - usuario quitado => se revoca su certificado (si OVPN_REVOKE_REMOVED=true)
# Caracteres permitidos: letras, números, "_", "." y "-" (máx. 64). "server" está reservado.
OVPN_USERS=ana,luis

# Revocar automáticamente los usuarios que se quiten de la lista.
OVPN_REVOKE_REMOVED=true

# Dirección que usarán los clientes. Si está vacío se usa <primer subdominio>.duckdns.org
OVPN_HOSTNAME=

# Puerto público (el que abres en el router) y protocolo (udp recomendado | tcp).
OVPN_PORT=1194
OVPN_PROTO=udp

# Subred interna del túnel (no debe solaparse con tu LAN ni con la de los clientes).
OVPN_NETWORK=10.8.0.0/24

# DNS que se envían a los clientes (separados por coma).
OVPN_DNS=1.1.1.1,9.9.9.9

# true  = full tunnel: todo el tráfico del cliente sale por la VPN.
# false = split tunnel: solo las rutas de OVPN_PUSH_ROUTES.
OVPN_REDIRECT_GATEWAY=true

# Rutas adicionales a enviar a los clientes (ej. tu LAN: 192.168.1.0/24).
OVPN_PUSH_ROUTES=

# Permitir tráfico entre clientes de la VPN.
OVPN_CLIENT_TO_CLIENT=false

# Vigencia de certificados (días) y nombre de la CA (solo aplica al crear la PKI).
OVPN_CLIENT_CERT_DAYS=825
OVPN_SERVER_CERT_DAYS=1825
OVPN_CA_DAYS=3650
OVPN_CA_CN=openvpn-ca

# Cifrados de datos permitidos (negociados con el cliente).
OVPN_CIPHERS=AES-256-GCM:CHACHA20-POLY1305:AES-128-GCM

# Líneas extra para server.conf separadas por "|" (avanzado, opcional).
# Ej: OVPN_EXTRA_SERVER_CONFIG=max-clients 20|duplicate-cn
OVPN_EXTRA_SERVER_CONFIG=

# Verbosidad de logs de OpenVPN (0-11, 3 recomendado).
OVPN_VERB=3
